{
  "name": "whilefree",
  "version": "0.1.0",
  "private": true,
  "description": "Ask ChatGPT, Claude, Gemini, Perplexity and DeepSeek at once. Free, open source, no account, no API keys.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/5ghzx/whilefree.git"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch firefox",
    "chromium": "sh scripts/run-chromium.sh",
    "package": "node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "firefox": "sh scripts/install-firefox.sh",
    "icons": "node scripts/make-icons.mjs",
    "audio": "node scripts/make-audio.mjs",
    "verify": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
